# ==============================================================================
# KALAVATRI BACKEND CONFIGURATION TEMPLATE
# ==============================================================================

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Database (Required)
# Get these from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# ------------------------------------------------------------------------------
# 2. Authentication & Admin Security (Generate min 32-char strings)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here
COOKIE_SECRET=your_cookie_signing_secret_here

# ------------------------------------------------------------------------------
# 3. Super Admin Initial Setup (Seeded into Supabase on first run)
# ------------------------------------------------------------------------------
SUPERADMIN_EMAIL=kalavatri01@gmail.com
SUPERADMIN_INITIAL_PASSWORD=Kalavatri#Admin2026!
ADMIN_PATH_PREFIX=/kv-portal-7x9

# ------------------------------------------------------------------------------
# 4. Payment Gateway (Razorpay)
# Get these from: Razorpay Dashboard -> Settings -> API Keys
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret

# ------------------------------------------------------------------------------
# 5. Order Confirmation Emails (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM_NAME=KALAVATRI
EMAIL_FROM_ADDRESS=support@kalavatri.in

# ------------------------------------------------------------------------------
# 6. Store Details
# ------------------------------------------------------------------------------
STORE_NAME=KALAVATRI
STORE_DOMAIN=kalavatri.in
SUPPORT_EMAIL=support@kalavatri.in
